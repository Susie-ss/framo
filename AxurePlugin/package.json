{
  "name": "axure-sync-service",
  "productName": "AxureSyncService",
  "version": "1.0.0",
  "description": "AxureSyncService",
  "main": "electron-main.js",
  "scripts": {
    "start": "node main.js",
    "electron": "electron electron-main.js",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.protoplatform.axure-sync",
    "productName": "AxureSyncService",
    "directories": {
      "output": "dist"
    },
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "electron-main.js",
      "index.html",
      "ui.js",
      "config.json",
      "app-icon.png",
      "cookies.txt",
      "manifest.json",
      "preview/**",
      "node_modules/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/.cache/**"
    ],
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AxureSyncService"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "chrome-launcher": "^1.2.1",
    "chrome-remote-interface": "^0.34.0",
    "form-data": "^4.0.5",
    "fs-extra": "^11.3.5",
    "http": "^0.0.1-security",
    "http-proxy": "^1.18.1",
    "serve-handler": "^6.1.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "png2icons": "^2.0.1"
  }
}
